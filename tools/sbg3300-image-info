#!/usr/bin/env python3
"""Read-only parser for the SBG3300 Broadcom/MSTC firmware container."""

import argparse
import pathlib
import struct
import sys
import zlib

TAG_SIZE = 0x20000
TAG_FIELDS = {
    "tag_version": (0x00, 4),
    "tag_identity": (0x04, 10),
    "model_id": (0x0E, 4),
    "chip_id": (0x26, 6),
    "board_id": (0x2C, 18),
    "total_image_len": (0x3E, 10),
    "cfe_address": (0x48, 10),
    "cfe_len": (0x54, 12),
    "rootfs_address": (0x5E, 12),
    "rootfs_len": (0x6A, 12),
    "kernel_address": (0x74, 12),
    "kernel_len": (0x80, 10),
    "firmware_version": (0x8E, 32),
    "rootfs_crc": (0xDC, 4),
    "kernel_crc": (0xE0, 4),
    "sequence": (0xE4, 4),
    "root_length": (0xE8, 4),
}


class ImageError(ValueError):
    pass


def raw_crc32(data):
    return zlib.crc32(data) ^ 0xFFFFFFFF


def ascii_field(data, offset, size, name):
    raw = data[offset:offset + size]
    if len(raw) != size:
        raise ImageError("truncated tag field: " + name)
    return raw.split(b"\0", 1)[0].decode("ascii", errors="replace").strip()


def decimal_field(data, name):
    value = ascii_field(data, *TAG_FIELDS[name], name)
    if not value or not value.isdecimal():
        raise ImageError("invalid decimal tag field: " + name)
    return int(value, 10)


def parse_image(data):
    """Parse a stock MSTC Broadcom-tag container; do not use this as writer."""
    if len(data) < TAG_SIZE + 0x100:
        raise ImageError("file too short for Broadcom tag")

    fields = {name: ascii_field(data, off, size, name)
              for name, (off, size) in TAG_FIELDS.items()}
    for name in ("tag_version", "total_image_len", "cfe_address", "cfe_len",
                 "rootfs_address", "rootfs_len", "kernel_address", "kernel_len"):
        if not fields[name] or not fields[name].isdecimal():
            raise ImageError("invalid decimal tag field: " + name)

    if fields["tag_identity"] not in ("MSTC", "MSTC_3300"):
        raise ImageError("unexpected firmware tag identity")
    if fields["chip_id"] != "63268" or fields["board_id"] != "963168MXH_17A":
        raise ImageError("image is for a different chip or board")

    total_len = int(fields["total_image_len"])
    cfe_len = int(fields["cfe_len"])
    rootfs_len = int(fields["rootfs_len"])
    kernel_len = int(fields["kernel_len"])
    payload_start = TAG_SIZE
    if total_len > len(data) - payload_start:
        raise ImageError(
            "declared payload exceeds file size (container/tag mismatch); "
            "do not treat this image as flashable"
        )
    payload_end = payload_start + total_len
    if total_len != cfe_len + rootfs_len + kernel_len:
        raise ImageError("tag lengths do not sum to total payload")

    version = fields["tag_version"]
    identity = fields["tag_identity"]
    model = fields["model_id"]
    chip = fields["chip_id"]
    board = fields["board_id"]
    firmware_version = fields["firmware_version"]

    stored_image_crc = struct.unpack_from(">I", data, 0xD8)[0]
    stored_rootfs_crc = struct.unpack_from(">I", data, 0xDC)[0]
    stored_kernel_crc = struct.unpack_from(">I", data, 0xE0)[0]
    stored_fskernel_crc = struct.unpack_from(">I", data, 0xC4)[0]
    header_crc = raw_crc32(data[:0xEC])
    payload = data[payload_start:payload_end]
    payload_crc = raw_crc32(payload)
    trailer_offset = payload_end
    trailer_flag = data[0xCE]
    trailer = None
    if trailer_flag == 1:
        trailer_size = len(data) - trailer_offset
        if trailer_size < 0x20:
            raise ImageError("trailer flag set but trailer area is truncated")
        trailer_data = data[trailer_offset:]
        trailer_crc_stored = struct.unpack_from(">I", trailer_data, 0x1C)[0]
        trailer_crc_computed = raw_crc32(trailer_data[:0x1C])
        trailer = {
            "offset": trailer_offset,
            "size": trailer_size,
            "prefix": trailer_data[:0x1C],
            "crc_stored": trailer_crc_stored,
            "crc_computed": trailer_crc_computed,
            "crc_ok": trailer_crc_stored == trailer_crc_computed,
        }
    elif trailer_flag not in (0,):
        raise ImageError("unsupported trailer flag")

    return {
        "file_size": len(data),
        "container_type": "stock-nand-page-oob-encoded-candidate",
        "raw_tag_identity": data[4:0x18],
        "tag": fields,
        "payload_start": payload_start,
        "payload_end": payload_end,
        "payload_crc": payload_crc,
        "stored_image_crc": stored_image_crc,
        "stored_rootfs_crc": stored_rootfs_crc,
        "stored_kernel_crc": stored_kernel_crc,
        "stored_fskernel_crc": stored_fskernel_crc,
        "image_crc_ok": payload_crc == stored_image_crc,
        "rootfs_crc_ok": payload_crc == stored_rootfs_crc,
        "header_crc": header_crc,
        "header_crc_stored": struct.unpack_from(">I", data, 0xEC)[0],
        "header_crc_ok": header_crc == struct.unpack_from(">I", data, 0xEC)[0],
        "trailer_flag": trailer_flag,
        "trailer": trailer,
        "lengths_consistent": total_len == cfe_len + rootfs_len + kernel_len,
        "structural_ok": version == "6" and identity in ("MSTC", "MSTC_3300") and
                         chip == "63268" and board == "963168MXH_17A" and
                         payload_end <= len(data),
    }


def fmt_crc(value):
    return "0x%08x" % value


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("image", type=pathlib.Path, help="firmware file to inspect; never modified")
    args = parser.parse_args()
    try:
        result = parse_image(args.image.read_bytes())
    except (OSError, ImageError) as exc:
        print("ERROR: " + str(exc), file=sys.stderr)
        return 2

    print("Interpretation: STOCK-NAND-RAW / PAGE-OOB ENCODED (candidate from bytes-per-page pattern)")
    print("File size: %d bytes" % result["file_size"])
    for name in ("tag_identity", "model_id", "chip_id", "board_id", "firmware_version"):
        print("%s: %s" % (name, result["tag"][name]))
    for name in ("cfe_address", "cfe_len", "rootfs_address", "rootfs_len",
                 "kernel_address", "kernel_len", "total_image_len"):
        print("%s: %s" % (name, result["tag"][name]))
    print("Payload file range: [0x%x, 0x%x)" %
          (result["payload_start"], result["payload_end"]))
    print("Header CRC: %s stored=%s %s" %
          (fmt_crc(result["header_crc"]), fmt_crc(result["header_crc_stored"]),
           "PASS" if result["header_crc_ok"] else "FAIL"))
    print("Payload length: computed CRC=%s; stored image CRC=%s; stored rootfs CRC=%s" %
          (fmt_crc(result["payload_crc"]), fmt_crc(result["stored_image_crc"]),
           fmt_crc(result["stored_rootfs_crc"])))
    print("Image CRC matches payload: %s" % ("YES" if result["image_crc_ok"] else "NO"))
    print("Rootfs CRC matches entire payload: %s" % ("YES" if result["rootfs_crc_ok"] else "NO"))
    print("Stored kernel CRC: %s; stored kernel+rootfs CRC: %s" %
          (fmt_crc(result["stored_kernel_crc"]), fmt_crc(result["stored_fskernel_crc"])))
    print("Tag header CRC: %s stored=%s %s" %
          (fmt_crc(result["header_crc"]), fmt_crc(result["header_crc_stored"]),
           "PASS" if result["header_crc_ok"] else "FAIL"))
    print("Trailer flag: 0x%02x" % result["trailer_flag"])
    if result["trailer"]:
        t = result["trailer"]
        print("Trailer offset: 0x%x size=%d bytes" % (t["offset"], t["size"]))
        print("Trailer CRC: %s stored=%s %s" %
              (fmt_crc(t["crc_computed"]), fmt_crc(t["crc_stored"]),
               "PASS" if t["crc_ok"] else "FAIL"))
    checks = [result["structural_ok"], result["lengths_consistent"],
              result["header_crc_ok"], result["image_crc_ok"],
              result["rootfs_crc_ok"],
              result["trailer"] is None or result["trailer"]["crc_ok"]]
    print("Offline parser checks: %s" % ("PASS" if all(checks) else "FAIL"))
    print("This tool does not emulate the router validator or authorize flashing.")
    return 0 if all(checks) else 1


if __name__ == "__main__":
    raise SystemExit(main())
