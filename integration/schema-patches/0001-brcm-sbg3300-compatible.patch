From: gianguyen14 <231934554+gianguyen14@users.noreply.github.com>
Subject: [PATCH] dt-bindings: mips: brcm document SBG3300 compatible chain

Add the exact board/family fallback chain used by the offline DTS. Keep the
existing SoC-only enum as a separate alternative. This documents identity,
not topology, PHY support or runtime validation. Original patch GPL-2.0-only.

---
--- a/Documentation/devicetree/bindings/mips/brcm/soc.yaml
+++ b/Documentation/devicetree/bindings/mips/brcm/soc.yaml
@@ -19,25 +19,30 @@
     const: '/'
 
   compatible:
-    enum:
-      - brcm,bcm3368
-      - brcm,bcm3384
-      - brcm,bcm33843
-      - brcm,bcm3384-viper
-      - brcm,bcm33843-viper
-      - brcm,bcm6328
-      - brcm,bcm6358
-      - brcm,bcm6362
-      - brcm,bcm6368
-      - brcm,bcm63168
-      - brcm,bcm63268
-      - brcm,bcm7125
-      - brcm,bcm7346
-      - brcm,bcm7358
-      - brcm,bcm7360
-      - brcm,bcm7362
-      - brcm,bcm7420
-      - brcm,bcm7425
+    oneOf:
+      - enum:
+          - brcm,bcm3368
+          - brcm,bcm3384
+          - brcm,bcm33843
+          - brcm,bcm3384-viper
+          - brcm,bcm33843-viper
+          - brcm,bcm6328
+          - brcm,bcm6358
+          - brcm,bcm6362
+          - brcm,bcm6368
+          - brcm,bcm63168
+          - brcm,bcm63268
+          - brcm,bcm7125
+          - brcm,bcm7346
+          - brcm,bcm7358
+          - brcm,bcm7360
+          - brcm,bcm7362
+          - brcm,bcm7420
+          - brcm,bcm7425
+      - items:
+          - const: zyxel,sbg3300-n000
+          - const: brcm,bcm63168
+          - const: brcm,bcm63268
 
   cpus:
     type: object
@@ -86,7 +91,7 @@
   properties:
     cpus:
       required:
-        - brcm,bmips-cbr-reg
+          - brcm,bmips-cbr-reg
 
 additionalProperties: true
 
