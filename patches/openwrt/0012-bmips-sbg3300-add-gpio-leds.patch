From 9328cfb67bd2b1a4f97b851d3d9db898a6b8a6a1 Mon Sep 17 00:00:00 2001
From: gianguyen14 <truongphamgianguyengl02@kawaii.edu.vn>
Date: Sun, 11 Oct 2026 03:10:39 +0700
Subject: [PATCH] bmips: sbg3300: add GPIO, LEDs, and Buttons from kcore map

---
 .../bmips/dts/bcm63168-zyxel-sbg3300-n000.dts | 58 +++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/target/linux/bmips/dts/bcm63168-zyxel-sbg3300-n000.dts b/target/linux/bmips/dts/bcm63168-zyxel-sbg3300-n000.dts
index 905ff23ae8..ca198d79a7 100644
--- a/target/linux/bmips/dts/bcm63168-zyxel-sbg3300-n000.dts
+++ b/target/linux/bmips/dts/bcm63168-zyxel-sbg3300-n000.dts
@@ -11,6 +11,60 @@
 		bootargs = "";
 		stdout-path = "";
 	};
+
+	keys {
+		compatible = "gpio-keys-polled";
+		poll-interval = <20>;
+
+		wps {
+			label = "wps";
+			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_WPS_BUTTON>;
+			debounce-interval = <60>;
+		};
+
+		reset {
+			label = "reset";
+			gpios = <&gpio 0 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+			debounce-interval = <60>;
+		};
+	};
+	
+	leds {
+		compatible = "gpio-leds";
+
+		power_green {
+			label = "green:power";
+			gpios = <&gpio 20 GPIO_ACTIVE_LOW>;
+			default-state = "on";
+		};
+
+		power_red {
+			label = "red:power";
+			gpios = <&gpio 21 GPIO_ACTIVE_LOW>;
+		};
+
+		dsl {
+			label = "green:dsl";
+			gpios = <&gpio 14 GPIO_ACTIVE_LOW>;
+		};
+
+		vdsl {
+			label = "green:vdsl";
+			gpios = <&gpio 15 GPIO_ACTIVE_LOW>;
+		};
+
+		internet_green {
+			label = "green:internet";
+			gpios = <&gpio 22 GPIO_ACTIVE_HIGH>;
+		};
+
+		wan {
+			label = "green:wan";
+			gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
+		};
+	};
 };
 
 /* These controllers are directly observed on the stock device. */
-- 
2.47.3
