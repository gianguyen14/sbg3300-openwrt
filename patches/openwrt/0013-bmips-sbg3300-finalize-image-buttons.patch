From ce87595bef57b4662fcc756aee3fdfd578c8ab42 Mon Sep 17 00:00:00 2001
From: gianguyen14 <truongphamgianguyengl02@kawaii.edu.vn>
Date: Mon, 12 Oct 2026 20:10:07 +0700
Subject: [PATCH] bmips: sbg3300: finalize sysupgrade image and button gpio
 assignments

---
 target/linux/bmips/dts/bcm63168-zyxel-sbg3300-n000.dts | 4 ++--
 target/linux/bmips/image/bcm63268.mk                   | 3 +--
 2 files changed, 3 insertions(+), 4 deletions(-)

diff --git a/target/linux/bmips/dts/bcm63168-zyxel-sbg3300-n000.dts b/target/linux/bmips/dts/bcm63168-zyxel-sbg3300-n000.dts
index ca198d79a7..bac1f87039 100644
--- a/target/linux/bmips/dts/bcm63168-zyxel-sbg3300-n000.dts
+++ b/target/linux/bmips/dts/bcm63168-zyxel-sbg3300-n000.dts
@@ -18,14 +18,14 @@
 
 		wps {
 			label = "wps";
-			gpios = <&ext_irq 1 GPIO_ACTIVE_LOW>;
+			gpios = <&gpio 33 GPIO_ACTIVE_LOW>;
 			linux,code = <KEY_WPS_BUTTON>;
 			debounce-interval = <60>;
 		};
 
 		reset {
 			label = "reset";
-			gpios = <&ext_irq 0 GPIO_ACTIVE_LOW>;
+			gpios = <&gpio 32 GPIO_ACTIVE_LOW>;
 			linux,code = <KEY_RESTART>;
 			debounce-interval = <60>;
 		};
diff --git a/target/linux/bmips/image/bcm63268.mk b/target/linux/bmips/image/bcm63268.mk
index 83505c8a04..c8c229d7cc 100644
--- a/target/linux/bmips/image/bcm63268.mk
+++ b/target/linux/bmips/image/bcm63268.mk
@@ -7,13 +7,12 @@ define Device/zyxel_sbg3300-n000
   DEVICE_MODEL := SBG3300-N000
   CHIP_ID := 63268
   SOC := bcm63168
-  CFE_RAM_FILE := zyxel,sbg3300/cferam.000
-  CFE_RAM_JFFS2_NAME := cferam.000
   BLOCKSIZE := 128k
   PAGESIZE := 2048
   SUBPAGESIZE := 512
   VID_HDR_OFFSET := 2048
   DEVICE_PACKAGES += $(USB2_PACKAGES)
+  IMAGES := sysupgrade.bin
 endef
 TARGET_DEVICES += zyxel_sbg3300-n000
 
-- 
2.47.3

