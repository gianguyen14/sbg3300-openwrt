From: gianguyen14 <231934554+gianguyen14@users.noreply.github.com>
Subject: [PATCH] bmips: guard enetsw RX descriptors and NAPI polling

Software corrections only; no board hardware activation.

diff --git a/target/linux/bmips/patches-6.18/999-z-bcm6368-enetsw-rx-poll.patch b/target/linux/bmips/patches-6.18/999-z-bcm6368-enetsw-rx-poll.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/bmips/patches-6.18/999-z-bcm6368-enetsw-rx-poll.patch
@@ -0,0 +1,81 @@
+From: gianguyen14 <231934554+gianguyen14@users.noreply.github.com>
+Subject: [PATCH] net: bcm6368-enetsw bound RX and honor NAPI completion
+
+Reject malformed/error RX descriptors before DMA sync or skb construction.
+Do not scan an empty ring or receive in a zero-budget poll. Restore interrupts
+only when NAPI completion permits it. Snapshot TX status before descriptor reuse
+and use DMA ownership barriers with single descriptor status accesses.
+Original changes GPL-2.0-or-later; upstream attribution remains intact.
+
+diff --git a/drivers/net/ethernet/broadcom/bcm6368-enetsw.c b/drivers/net/ethernet/broadcom/bcm6368-enetsw.c
+--- a/drivers/net/ethernet/broadcom/bcm6368-enetsw.c
++++ b/drivers/net/ethernet/broadcom/bcm6368-enetsw.c
+@@ -303,2 +303,2 @@
+-		wmb();
+-		desc->len_stat = len_stat;
++		dma_wmb();
++		WRITE_ONCE(desc->len_stat, len_stat);
+@@ -359 +359 @@
+-	do {
++	while (processed < budget) {
+@@ -370,5 +370 @@
+-		/* make sure we actually read the descriptor status at
+-		 * each loop */
+-		rmb();
+-
+-		len_stat = desc->len_stat;
++		len_stat = READ_ONCE(desc->len_stat);
+@@ -378,0 +375,3 @@
++
++		/* Ownership must be observed before descriptor/buffer reads. */
++		dma_rmb();
+@@ -391,0 +391,6 @@
++		if (len_stat & DMADESC_ERR_MASK) {
++			ndev->stats.rx_errors++;
++			ndev->stats.rx_dropped++;
++			continue;
++		}
++
+@@ -396,2 +401,10 @@
+-		/* don't include FCS */
+-		len -= 4;
++		/* Validate the DMA length before subtracting FCS or using it
++		 * for cache synchronization, copying, or skb_put().
++		 */
++		if (len < ETH_HLEN + ETH_FCS_LEN || len > priv->rx_buf_size) {
++			ndev->stats.rx_errors++;
++			ndev->stats.rx_length_errors++;
++			ndev->stats.rx_dropped++;
++			continue;
++		}
++		len -= ETH_FCS_LEN;
+@@ -435 +448 @@
+-	} while (processed < budget);
++	}
+@@ -467,0 +481 @@
++		u32 len_stat;
+@@ -475 +489,2 @@
+-		if (!force && (desc->len_stat & DMADESC_OWNER_MASK)) {
++		len_stat = READ_ONCE(desc->len_stat);
++		if (!force && (len_stat & DMADESC_OWNER_MASK)) {
+@@ -482 +497 @@
+-		rmb();
++		dma_rmb();
+@@ -496 +511,2 @@
+-		if (desc->len_stat & DMADESC_UNDER_MASK)
++		/* The descriptor can be reused by xmit after unlocking. */
++		if (len_stat & DMADESC_UNDER_MASK)
+@@ -529,0 +546,4 @@
++	/* A zero-budget poll is TX-only and must not complete NAPI. */
++	if (!budget)
++		return 0;
++
+@@ -541 +561,2 @@
+-	napi_complete_done(napi, rx_work_done);
++	if (!napi_complete_done(napi, rx_work_done))
++		return rx_work_done;
+@@ -640,2 +661,2 @@
+-	wmb();
+-	desc->len_stat = len_stat;
++	dma_wmb();
++	WRITE_ONCE(desc->len_stat, len_stat);
