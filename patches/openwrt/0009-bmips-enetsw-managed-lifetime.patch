From: gianguyen14 <231934554+gianguyen14@users.noreply.github.com>
Subject: [PATCH] bmips: include Ethernet probe and teardown corrections

Actual Linux resource management changes, with no board activation.

diff --git a/target/linux/bmips/patches-6.18/999-runtime-bcm6368-enetsw-lifetime.patch b/target/linux/bmips/patches-6.18/999-runtime-bcm6368-enetsw-lifetime.patch
new file mode 100644
--- /dev/null
+++ b/target/linux/bmips/patches-6.18/999-runtime-bcm6368-enetsw-lifetime.patch
@@ -0,0 +1,390 @@
+From: gianguyen14 <231934554+gianguyen14@users.noreply.github.com>
+Subject: [PATCH] net: bcm6368-enetsw manage probe and remove resource lifetime
+
+Unwind PM domains, runtime references, clocks, resets and NAPI on each probe
+error. Managed netdev unregister runs before controller resources are removed.
+Preserve deferred IRQ lookup and reject erroneous optional IRQs. Do not inspect
+uninitialized MAC bytes on a failed platform lookup. Return ENOMEM for failed
+array allocation. The existing generic random-MAC fallback remains unchanged.
+Original additions GPL-2.0-or-later; upstream copyright is retained.
+
+---
+diff --git a/drivers/net/ethernet/broadcom/bcm6368-enetsw.c b/drivers/net/ethernet/broadcom/bcm6368-enetsw.c
+--- a/drivers/net/ethernet/broadcom/bcm6368-enetsw.c
++++ b/drivers/net/ethernet/broadcom/bcm6368-enetsw.c
+@@ -21,6 +21,7 @@
+ #include <linux/pm_runtime.h>
+ #include <linux/reset.h>
+ #include <linux/version.h>
++#include "enetsw_contract.h"
+ 
+ /* TODO: Bigger frames may work but we do not trust that they are safe on all
+  * platforms so more research is needed, a max frame size of 2048 has been
+@@ -594,7 +595,6 @@
+ 	/* pad small packets */
+ 	if (skb->len < (ETH_ZLEN + ETH_FCS_LEN)) {
+ 		int needed = (ETH_ZLEN + ETH_FCS_LEN) - skb->len;
+-		char *data;
+ 
+ 		if (unlikely(skb_tailroom(skb) < needed)) {
+ 			struct sk_buff *nskb;
+@@ -608,7 +608,7 @@
+ 			dev_kfree_skb(skb);
+ 			skb = nskb;
+ 		}
+-		data = skb_put_zero(skb, needed);
++		skb_put_zero(skb, needed);
+ 	}
+ 
+ 	/* fill descriptor */
+@@ -915,6 +915,46 @@
+ 	.ndo_start_xmit = bcm6368_enetsw_start_xmit,
+ };
+ 
++static void bcm6368_enetsw_detach_domains(void *data)
++{
++	struct bcm6368_enetsw *priv = data;
++	unsigned int i;
++
++	for (i = priv->num_pms; i > 0; i--) {
++		if (priv->link_pm[i - 1])
++			device_link_del(priv->link_pm[i - 1]);
++		if (!IS_ERR_OR_NULL(priv->pm[i - 1]))
++			dev_pm_domain_detach(priv->pm[i - 1], true);
++	}
++}
++
++static void bcm6368_enetsw_put_pm(void *data)
++{
++	pm_runtime_put_sync(data);
++}
++
++static void bcm6368_enetsw_put_clock(void *data)
++{
++	clk_put(data);
++}
++
++static void bcm6368_enetsw_disable_clock(void *data)
++{
++	clk_disable_unprepare(data);
++}
++
++static void bcm6368_enetsw_assert_reset(void *data)
++{
++	reset_control_assert(data);
++}
++
++static void bcm6368_enetsw_delete_napi(void *data)
++{
++	struct bcm6368_enetsw *priv = data;
++
++	netif_napi_del(&priv->napi);
++}
++
+ static int bcm6368_enetsw_probe(struct platform_device *pdev)
+ {
+ 	struct device *dev = &pdev->dev;
+@@ -922,9 +962,10 @@
+ 	struct bcm6368_enetsw *priv;
+ 	struct net_device *ndev;
+ 	struct resource *res;
++	resource_size_t channel_bytes, state_bytes;
+ 	unsigned char dev_addr[ETH_ALEN];
+ 	unsigned i;
+-	int num_resets;
++	int num_resets, num_pms;
+ 	int ret;
+ 
+ 	ndev = devm_alloc_etherdev(dev, sizeof(*priv));
+@@ -938,8 +979,11 @@
+ 	priv->pdev = pdev;
+ 	priv->net_dev = ndev;
+ 
+-	priv->num_pms = of_count_phandle_with_args(node, "power-domains",
+-						   "#power-domain-cells");
++	num_pms = of_count_phandle_with_args(node, "power-domains",
++					     "#power-domain-cells");
++	if (num_pms < 0 && num_pms != -ENOENT)
++		return num_pms;
++	priv->num_pms = max(num_pms, 0);
+ 	if (priv->num_pms > 1) {
+ 		priv->pm = devm_kcalloc(dev, priv->num_pms,
+ 					sizeof(struct device *), GFP_KERNEL);
+@@ -952,59 +996,71 @@
+ 		if (!priv->link_pm)
+ 			return -ENOMEM;
+ 
++		ret = devm_add_action_or_reset(dev, bcm6368_enetsw_detach_domains, priv);
++		if (ret)
++			return ret;
++
+ 		for (i = 0; i < priv->num_pms; i++) {
+ 			priv->pm[i] = genpd_dev_pm_attach_by_id(dev, i);
+-			if (IS_ERR(priv->pm[i])) {
+-				dev_err(dev, "error getting pm %d\n", i);
+-				return -EINVAL;
+-			}
++			if (IS_ERR_OR_NULL(priv->pm[i]))
++				return dev_err_probe(dev, priv->pm[i] ? PTR_ERR(priv->pm[i]) :
++						     -ENODEV, "error getting pm %u\n", i);
+ 
+ 			priv->link_pm[i] = device_link_add(dev, priv->pm[i],
+ 				DL_FLAG_STATELESS | DL_FLAG_PM_RUNTIME |
+ 				DL_FLAG_RPM_ACTIVE);
++			if (!priv->link_pm[i])
++				return -ENOMEM;
+ 		}
+ 	}
+ 
+-	pm_runtime_enable(dev);
+ 	pm_runtime_no_callbacks(dev);
+-	ret = pm_runtime_get_sync(dev);
+-	if (ret < 0) {
+-		pm_runtime_disable(dev);
+-		dev_info(dev, "PM prober defer: ret=%d\n", ret);
+-		return -EPROBE_DEFER;
+-	}
++	ret = devm_pm_runtime_enable(dev);
++	if (ret)
++		return ret;
++	ret = pm_runtime_resume_and_get(dev);
++	if (ret < 0)
++		return dev_err_probe(dev, ret, "error resuming controller\n");
++	ret = devm_add_action_or_reset(dev, bcm6368_enetsw_put_pm, dev);
++	if (ret)
++		return ret;
+ 
+ 	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dma");
+ 	priv->dma_base = devm_ioremap_resource(dev, res);
+-	if (IS_ERR_OR_NULL(priv->dma_base))
++	if (IS_ERR(priv->dma_base))
+ 		return PTR_ERR(priv->dma_base);
+ 
+ 	res = platform_get_resource_byname(pdev, IORESOURCE_MEM,
+ 					   "dma-channels");
+ 	priv->dma_chan = devm_ioremap_resource(dev, res);
+-	if (IS_ERR_OR_NULL(priv->dma_chan))
++	if (IS_ERR(priv->dma_chan))
+ 		return PTR_ERR(priv->dma_chan);
++	channel_bytes = resource_size(res);
+ 
+ 	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "dma-sram");
+ 	priv->dma_sram = devm_ioremap_resource(dev, res);
+-	if (IS_ERR_OR_NULL(priv->dma_sram))
++	if (IS_ERR(priv->dma_sram))
+ 		return PTR_ERR(priv->dma_sram);
++	state_bytes = resource_size(res);
+ 
+-	priv->irq_rx = platform_get_irq_byname(pdev, "rx");
+-	if (!priv->irq_rx)
+-		return -ENODEV;
+-
+-	priv->irq_tx = platform_get_irq_byname(pdev, "tx");
+-	if (!priv->irq_tx)
+-		return -ENODEV;
+-	else if (priv->irq_tx < 0)
+-		priv->irq_tx = -1;
++	ret = enetsw_irq_config(platform_get_irq_byname(pdev, "rx"), true,
++				&priv->irq_rx);
++	if (ret)
++		return ret;
++	ret = enetsw_irq_config(platform_get_irq_byname(pdev, "tx"), false,
++				&priv->irq_tx);
++	if (ret)
++		return ret;
+ 
+ 	if (device_property_read_u32(dev, "dma-rx", &priv->rx_chan))
+ 		return -ENODEV;
+ 
+ 	if (device_property_read_u32(dev, "dma-tx", &priv->tx_chan))
+ 		return -ENODEV;
++	ret = enetsw_channel_check(priv->rx_chan, priv->tx_chan,
++				   channel_bytes, state_bytes);
++	if (ret)
++		return ret;
+ 
+ 	priv->rx_ring_size = ENETSW_DEF_RX_DESC;
+ 	priv->tx_ring_size = ENETSW_DEF_TX_DESC;
+@@ -1014,7 +1070,7 @@
+ 	if (ret == -EPROBE_DEFER)
+ 		return ret;
+ 
+-	if (is_valid_ether_addr(dev_addr)) {
++	if (!ret && is_valid_ether_addr(dev_addr)) {
+ 		dev_addr_set(ndev, dev_addr);
+ 		dev_info(dev, "mtd mac %pM\n", dev_addr);
+ 	} else {
+@@ -1031,8 +1087,8 @@
+ 	if (priv->num_clocks) {
+ 		priv->clock = devm_kcalloc(dev, priv->num_clocks,
+ 					   sizeof(struct clk *), GFP_KERNEL);
+-		if (IS_ERR_OR_NULL(priv->clock))
+-			return PTR_ERR(priv->clock);
++		if (!priv->clock)
++			return -ENOMEM;
+ 	}
+ 	for (i = 0; i < priv->num_clocks; i++) {
+ 		priv->clock[i] = of_clk_get(node, i);
+@@ -1041,11 +1097,19 @@
+ 			return PTR_ERR(priv->clock[i]);
+ 		}
+ 
++		ret = devm_add_action_or_reset(dev, bcm6368_enetsw_put_clock,
++					       priv->clock[i]);
++		if (ret)
++			return ret;
+ 		ret = clk_prepare_enable(priv->clock[i]);
+ 		if (ret) {
+ 			dev_err(dev, "error enabling clock %d\n", i);
+ 			return ret;
+ 		}
++		ret = devm_add_action_or_reset(dev, bcm6368_enetsw_disable_clock,
++					       priv->clock[i]);
++		if (ret)
++			return ret;
+ 	}
+ 
+ 	num_resets = of_count_phandle_with_args(node, "resets",
+@@ -1058,8 +1122,8 @@
+ 		priv->reset = devm_kcalloc(dev, priv->num_resets,
+ 					   sizeof(struct reset_control *),
+ 					   GFP_KERNEL);
+-		if (IS_ERR_OR_NULL(priv->reset))
+-			return PTR_ERR(priv->reset);
++		if (!priv->reset)
++			return -ENOMEM;
+ 	}
+ 	for (i = 0; i < priv->num_resets; i++) {
+ 		priv->reset[i] = devm_reset_control_get_by_index(dev, i);
+@@ -1073,6 +1137,10 @@
+ 			dev_err(dev, "error performing reset %d\n", i);
+ 			return ret;
+ 		}
++		ret = devm_add_action_or_reset(dev, bcm6368_enetsw_assert_reset,
++					       priv->reset[i]);
++		if (ret)
++			return ret;
+ 	}
+ 
+ 	spin_lock_init(&priv->rx_lock);
+@@ -1085,47 +1153,20 @@
+ 	ndev->mtu = ETH_DATA_LEN;
+ 	ndev->max_mtu = ENETSW_MAX_MTU;
+ 	netif_napi_add_weight(ndev, &priv->napi, bcm6368_enetsw_poll, 16);
++	ret = devm_add_action_or_reset(dev, bcm6368_enetsw_delete_napi, priv);
++	if (ret)
++		return ret;
+ 
++	/* Registered last: netdev stops before NAPI, resets, clocks and PM unwind. */
+ 	ret = devm_register_netdev(dev, ndev);
+-	if (ret) {
+-		netif_napi_del(&priv->napi);
+-		goto out_disable_clk;
+-	}
++	if (ret)
++		return ret;
+ 
+ 	netif_carrier_off(ndev);
+ 
+ 	dev_info(dev, "%s at 0x%px, IRQ %d\n", ndev->name, priv->dma_base, ndev->irq);
+ 
+ 	return 0;
+-
+-out_disable_clk:
+-	for (i = 0; i < priv->num_resets; i++)
+-		reset_control_assert(priv->reset[i]);
+-
+-	for (i = 0; i < priv->num_clocks; i++)
+-		clk_disable_unprepare(priv->clock[i]);
+-
+-	return ret;
+-}
+-
+-static void bcm6368_enetsw_remove(struct platform_device *pdev)
+-{
+-	struct device *dev = &pdev->dev;
+-	struct net_device *ndev = platform_get_drvdata(pdev);
+-	struct bcm6368_enetsw *priv = netdev_priv(ndev);
+-	unsigned int i;
+-
+-	pm_runtime_put_sync(dev);
+-	for (i = 0; priv->pm && i < priv->num_pms; i++) {
+-		dev_pm_domain_detach(priv->pm[i], true);
+-		device_link_del(priv->link_pm[i]);
+-	}
+-
+-	for (i = 0; i < priv->num_resets; i++)
+-		reset_control_assert(priv->reset[i]);
+-
+-	for (i = 0; i < priv->num_clocks; i++)
+-		clk_disable_unprepare(priv->clock[i]);
+ }
+ 
+ static const struct of_device_id bcm6368_enetsw_of_match[] = {
+@@ -1144,11 +1185,12 @@
+ 		.of_match_table = bcm6368_enetsw_of_match,
+ 	},
+ 	.probe	= bcm6368_enetsw_probe,
+-	.remove	= bcm6368_enetsw_remove,
+ };
+ module_platform_driver(bcm6368_enetsw_driver);
+ 
+ MODULE_AUTHOR("Álvaro Fernández Rojas <noltari@gmail.com>");
+ MODULE_DESCRIPTION("BCM6368 Ethernet Switch Controller Driver");
++/* Retain description when OpenWrt CONFIG_MODULE_STRIPPED is selected. */
++MODULE_INFO(description, "BCM6368 Ethernet Switch Controller Driver");
+ MODULE_LICENSE("GPL v2");
+ MODULE_ALIAS("platform:bcm6368-enetsw");
+diff --git a/drivers/net/ethernet/broadcom/enetsw_contract.h b/drivers/net/ethernet/broadcom/enetsw_contract.h
+new file mode 100644
+--- /dev/null
++++ b/drivers/net/ethernet/broadcom/enetsw_contract.h
+@@ -0,0 +1,48 @@
++/* SPDX-License-Identifier: GPL-2.0-or-later */
++#ifndef SBG3300_ENETSW_CONTRACT_H
++#define SBG3300_ENETSW_CONTRACT_H
++
++#ifdef __KERNEL__
++#include <linux/errno.h>
++#include <linux/types.h>
++typedef u32 enet_u32;
++typedef u64 enet_u64;
++#else
++#include <errno.h>
++#include <stdbool.h>
++#include <stdint.h>
++typedef uint32_t enet_u32;
++typedef uint64_t enet_u64;
++#endif
++
++/* Optional TX IRQ absence selects the existing polling path; all other
++ * lookup failures (including deferred probe) must reach the caller.
++ */
++static inline int enetsw_irq_config(int irq, bool required, int *effective)
++{
++	if (!effective)
++		return -EINVAL;
++	if (irq > 0) {
++		*effective = irq;
++		return 0;
++	}
++	if (!required && (irq == -ENXIO || irq == -ENOENT)) {
++		*effective = -1;
++		return 0;
++	}
++	return irq ? irq : -ENODEV;
++}
++
++/* The actual driver addresses channel and SRAM records with a 16-byte stride.
++ * Derive bounds from its mapped resources; do not guess port/channel topology.
++ */
++static inline int enetsw_channel_check(enet_u32 rx, enet_u32 tx,
++				       enet_u64 channel_bytes, enet_u64 state_bytes)
++{
++	if (rx == tx || rx >= channel_bytes / 16 || tx >= channel_bytes / 16 ||
++	    rx >= state_bytes / 16 || tx >= state_bytes / 16)
++		return -EINVAL;
++	return 0;
++}
++
++#endif
